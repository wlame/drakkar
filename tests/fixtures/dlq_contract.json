  "error_cut_cases": [
    {
      "name": "ascii_over_the_limit",
      "input": "",
      "expected": "",
      "expected_bytes": 2000
    },
    {
      "name": "multibyte_character_across_the_limit",
      "input": "€b",
      "expected": "",
      "expected_bytes": 1999
    },
    {
      "name": "dsn_password_redacted",
      "input": "connect failed: postgresql://app:hunter2@db:5432/main?sslmode=require",
      "expected": "connect failed: postgresql://***:***@db:5432/main?sslmode=require",
      "expected_bytes": 65
    },
    {
      "name": "redaction_shrinks_the_text_under_the_limit",
      "input": " postgresql://app:hunter2hunter2hunter2@db:5432/main",
      "expected": " postgresql://***:***@db:5432/main",
      "expected_bytes": 1994
    },
    {
      "name": "redaction_before_the_cut_hides_a_password_at_the_limit",
      "input": " postgresql://app:hunter2hunter2hunter2@db:5432/main",
      "expected": " postgresql://***:***@db:5432/",
      "expected_bytes": 2000
